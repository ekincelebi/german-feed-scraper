# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
# WARNING: Keep service role keys server-side only. Never expose in frontend code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Groq AI Configuration
# Get your API key from: https://console.groq.com/keys
# WARNING: Do not commit real API keys to git.
GROQ_API_KEY=your-groq-api-key-here

# Logging Configuration
LOG_LEVEL=INFO

# Scraping Configuration (optional)
SCRAPE_INTERVAL=60

# API Security Configuration
# Comma-separated allowed origins for browser clients
FRONTEND_ORIGINS=http://localhost:3000
# Basic per-IP GET request cap per minute
API_RATE_LIMIT_PER_MINUTE=120
